<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 15 : l'application garde la disposition classique (barre d'état au-dessus, clavier qui réduit la page),
      sans dessiner sous les barres du système.
    -->
    <style name="Theme.Synapse" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/noir</item>
        <item name="android:colorBackground">@color/noir</item>
        <item name="android:statusBarColor">@color/noir</item>
        <item name="android:navigationBarColor">@color/noir</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#FF00E5FF</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
