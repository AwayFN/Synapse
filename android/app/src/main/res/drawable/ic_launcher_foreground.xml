<?xml version="1.0" encoding="utf-8"?>
<!-- L'icône de Synapse (app/public/icon.svg) : un neurone néon relié à quatre autres -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- les axones -->
    <path
        android:pathData="M54,54 L33.5,37.7 M54,54 L74.2,34.9 M54,54 L73.1,73.1 M54,54 L34.9,71.4"
        android:strokeWidth="1.3"
        android:strokeColor="#8C00E5FF"
        android:strokeLineCap="round" />

    <!-- l'éclat du neurone central -->
    <path android:pathData="M33,54 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="21"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#FFFF2E88" android:offset="0.22" />
                <item android:color="#597A1CFF" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- les quatre neurones reliés -->
    <path android:fillColor="#FF00E5FF" android:pathData="M30.4,37.7 a3.1,3.1 0 1,0 6.2,0 a3.1,3.1 0 1,0 -6.2,0 Z" />
    <path android:fillColor="#FFA855F7" android:pathData="M71.7,34.9 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 Z" />
    <path android:fillColor="#FF39FF88" android:pathData="M69.7,73.1 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0 Z" />
    <path android:fillColor="#FFFFB020" android:pathData="M32.65,71.4 a2.25,2.25 0 1,0 4.5,0 a2.25,2.25 0 1,0 -4.5,0 Z" />

    <!-- le cœur blanc -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M49.2,54 a4.8,4.8 0 1,0 9.6,0 a4.8,4.8 0 1,0 -9.6,0 Z" />
</vector>
